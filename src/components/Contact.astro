      <!-- Right: Decorative -->
      <div class="contact-art reveal reveal-d2" aria-hidden="true">
        <div class="art-card glass">
          <div class="art-top">
            <span class="art-tag">Available</span>
            <span class="art-dot"></span>
          </div>
          <p class="art-headline">Let's build something<br /><span class="text-cyan">intelligent</span>.</p>
          <p class="art-sub">
            AI/ML engineering · LLM systems · Production software
          </p>
          <a href="mailto:hasratmd697@gmail.com" class="btn btn-primary art-cta">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
