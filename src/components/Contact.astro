            Send a message
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section { background: var(--bg-base); }

  .contact-inner {
    display: grid;
    grid-template-columns: 1fr 420px;
    gap: var(--s-16);
    align-items: center;
  }

  /* Text */
  .contact-text {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
  }

  .contact-desc {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 480px;
  }

  /* Info cards */
  .info-list { display: flex; flex-direction: column; gap: var(--s-3); }

  .info-card {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    padding: var(--s-4);
    cursor: default;
    transition: border-color var(--t-fast), transform var(--t-base);
  }
  a.info-card:hover {
    border-color: var(--cyan-border);
    transform: translateX(4px);
  }

  .info-icon {
    width: 42px; height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cyan-dim);
    color: var(--cyan);
    border-radius: var(--r-md);
    flex-shrink: 0;
    border: 1px solid var(--cyan-border);
  }

  .info-label {
    font-size: var(--text-xs);
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .info-value {
    font-size: var(--text-sm);
    color: var(--text-primary);
    font-weight: 500;
  }

  /* Social */
  .social-row { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    padding: 0.6rem 1.1rem;
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    transition: all var(--t-fast);
  }
  .social-btn:hover {
    background: var(--bg-overlay);
    color: var(--text-primary);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  /* Art card */
  .art-card {
    padding: var(--s-8);
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    position: relative;
    overflow: hidden;
  }
  .art-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--cyan), var(--violet));
  }

  .art-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .art-tag {
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .art-dot {
    width: 10px; height: 10px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 3px rgba(34,197,94,0.2);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 3px rgba(34,197,94,0.2); }
    50%       { box-shadow: 0 0 0 7px rgba(34,197,94,0); }
  }

  .art-headline {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .art-sub {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.6;
  }

  .art-cta { align-self: flex-start; }

  @media (max-width: 1024px) {
    .contact-inner { grid-template-columns: 1fr; gap: var(--s-10); }
    .contact-art   { max-width: 480px; }
  }
  @media (max-width: 640px) {
    .social-row { gap: var(--s-2); }
    .social-btn { font-size: var(--text-xs); padding: 0.5rem 0.875rem; }
  }
</style>
