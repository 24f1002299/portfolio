---
const certs = [
  {
    name: '5-Day AI Agents Intensive',
    issuer: 'Google & Kaggle',
    date: 'Dec 2025',
    tags: ['Agentic AI', 'Gen AI'],
    verifyUrl: '#',
    accent: 'cyan',
  },
  {
    name: 'Oracle AI Vector Search Professional',
    issuer: 'Oracle · 1Z0-184-25',
    date: 'Jul 2025 – Jul 2027',
    tags: ['Vector DBs', 'RAG', 'Embeddings'],
    verifyUrl: '#',
    accent: 'violet',
  },
  {
    name: 'Oracle Generative AI Professional',
    issuer: 'Oracle · 1Z0-1127-25',
    date: 'Jul 2025 – Jul 2027',
    tags: ['Generative AI', 'OCI'],
    verifyUrl: '#',
    accent: 'violet',
  },
  {
    name: 'Oracle AI Foundations Associate',
    issuer: 'Oracle · 1Z0-1122-25',
    date: 'Jul 2025 – Jul 2027',
    tags: ['AI/ML', 'Deep Learning'],
    verifyUrl: '#',
    accent: 'violet',
  },
  {
    name: 'Google Cloud Data Analytics',
    issuer: 'Google',
    date: 'Mar 2025 – Mar 2028',
    tags: ['BigQuery', 'SQL', 'Looker'],
    verifyUrl: '#',
    accent: 'cyan',
  },
  {
    name: 'Gen AI Workshop',
    issuer: 'IIT Madras',
    date: '2025',
    tags: ['LLMs', 'Prompt Engineering'],
    verifyUrl: '#',
    accent: 'cyan',
  },
];
---

<section class="section certs-section" id="certifications" aria-labelledby="certs-heading">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag violet">Credentials</span>
      <h2 class="section-title" id="certs-heading">
        Certifications
      </h2>
      <p class="section-subtitle">Verified credentials across AI, cloud and data.</p>
    </div>

    <div class="certs-grid">
      {certs.map((c, i) => (
        <article
          class={`cert-card glass reveal reveal-d${(i % 3) + 1}`}
          aria-label={c.name}
        >
          <div class="cert-top">
            <div>
              <h3 class="cert-name">{c.name}</h3>
              <p class="cert-issuer">{c.issuer}</p>
            </div>
            <a
              href={c.verifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class={`verify-btn verify-${c.accent}`}
              aria-label={`Verify ${c.name} certificate`}
            >
              Verify ↗
            </a>
          </div>

          <div class="cert-bottom">
            <span class={`cert-date date-${c.accent}`}>{c.date}</span>
            <div class="tech-tags cert-tags">
              {c.tags.map(t => <span class="tech-tag">{t}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>

    <p class="cert-extra reveal">
      + 6 more certifications from Infosys Springboard including Python, OOP, Agile Scrum, NoSQL and Software Engineering
    </p>
  </div>
</section>

<style>
  .certs-section { background: var(--bg-surface); }

  .certs-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-4);
    margin-bottom: var(--s-6);
  }

  .cert-card {
    padding: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    transition: transform var(--t-base);
  }
  .cert-card:hover { transform: translateY(-3px); }

  .cert-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .cert-name {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }

  .cert-issuer {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .verify-btn {
    flex-shrink: 0;
    font-size: var(--text-xs);
    font-weight: 600;
    padding: 0.3rem 0.625rem;
    border-radius: var(--r-sm);
    white-space: nowrap;
    transition: opacity var(--t-fast);
  }
  .verify-btn:hover { opacity: 0.75; }
  .verify-cyan   { background: var(--cyan-dim);   color: var(--cyan);   border: 1px solid var(--cyan-border); }
  .verify-violet { background: var(--violet-dim); color: var(--violet); border: 1px solid var(--violet-border); }

  .cert-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--s-2);
  }

  .cert-date {
    font-size: var(--text-xs);
    font-weight: 500;
  }
  .date-cyan   { color: var(--cyan); }
  .date-violet { color: var(--violet); }

  .cert-tags { flex-wrap: wrap; }

  .cert-extra {
    text-align: center;
    font-size: var(--text-sm);
    color: var(--text-faint);
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .certs-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .certs-grid { grid-template-columns: 1fr; }
  }
</style>
