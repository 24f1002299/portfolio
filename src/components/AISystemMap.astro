---
const nodes = [
  { label: 'LLM', category: 'genai', x: 50, y: 16, tone: 'cyan' },
  { label: 'Agents', category: 'ai-agents', x: 22, y: 46, tone: 'cyan' },
  { label: 'RAG', category: 'genai', x: 50, y: 46, tone: 'violet' },
  { label: 'Vision', category: 'computer-vision', x: 78, y: 46, tone: 'violet' },
  { label: 'Backend', category: 'full-stack', x: 50, y: 78, tone: 'cyan' },
];
const connections = [
  ['50,16', '22,46'], ['50,16', '50,46'], ['50,16', '78,46'],
  ['22,46', '50,78'], ['50,46', '50,78'], ['78,46', '50,78'],
];
---

<section class="section system-section" aria-labelledby="system-heading">
  <div class="container system-layout">
    <div class="section-header reveal">
      <span class="section-tag violet">Systems Thinking</span>
      <h2 class="section-title" id="system-heading">An AI system is more than <span class="title-accent-violet">a model.</span></h2>
      <p class="section-subtitle">I combine models, retrieval, tools, and dependable software into applications people can use. Select a node to explore related work.</p>
    </div>
    <div class="map-wrap glass reveal reveal-d2">
      <div class="map-canvas" role="group" aria-label="Interactive AI systems map">
        <svg class="connections" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {connections.map(([from, to]) => <line x1={from.split(',')[0]} y1={from.split(',')[1]} x2={to.split(',')[0]} y2={to.split(',')[1]} />)}
        </svg>
        {nodes.map(node => (
          <button class={`map-node ${node.tone}`} data-category={node.category} style={`--x:${node.x}%;--y:${node.y}%`} aria-label={`Show ${node.label} projects`}>
            {node.label}
          </button>
        ))}
      </div>
      <p class="map-note" aria-live="polite">Select a node to filter the project library.</p>
    </div>
  </div>
</section>

<style>
  .system-section { background: var(--bg-surface); }
  .system-layout { display: grid; grid-template-columns: minmax(0, .9fr) minmax(360px, 1.1fr); align-items: center; gap: var(--s-12); }
  .system-layout .section-header { margin: 0; }
  .map-wrap { padding: var(--s-6); }
  .map-canvas { position: relative; min-height: 330px; overflow: hidden; border: 1px solid var(--border); border-radius: var(--r-md); background: radial-gradient(circle at 50% 50%, var(--cyan-dim), transparent 52%), var(--bg-base); }
  .map-canvas::before { content: ''; position: absolute; inset: 0; opacity: .45; background-image: linear-gradient(var(--border) 1px, transparent 1px), linear-gradient(90deg, var(--border) 1px, transparent 1px); background-size: 28px 28px; }
  .connections { position: absolute; inset: 0; width: 100%; height: 100%; }
  .connections line { stroke: var(--cyan); stroke-opacity: .42; stroke-width: .45; stroke-dasharray: 2 2; animation: data-flow 2.4s linear infinite; }
  .map-node { position: absolute; left: var(--x); top: var(--y); transform: translate(-50%, -50%); z-index: 1; min-width: 86px; padding: .6rem .85rem; border-radius: var(--r-full); border: 1px solid var(--cyan-border); background: rgba(13, 17, 23, .9); color: var(--cyan); font-size: var(--text-xs); font-weight: 700; letter-spacing: .05em; box-shadow: 0 0 0 5px var(--cyan-dim); transition: transform var(--t-fast), box-shadow var(--t-fast), background var(--t-fast); }
  .map-node.violet { color: var(--violet); border-color: var(--violet-border); box-shadow: 0 0 0 5px var(--violet-dim); }
  .map-node:hover, .map-node:focus-visible { transform: translate(-50%, -50%) scale(1.08); background: var(--bg-overlay); }
  .map-note { margin-top: var(--s-4); color: var(--text-muted); font-size: var(--text-xs); text-align: center; }
  @media (max-width: 800px) { .system-layout { grid-template-columns: 1fr; gap: var(--s-8); } .map-canvas { min-height: 290px; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.map-node').forEach(node => {
    node.addEventListener('click', () => {
      const category = node.dataset.category;
      if (category) document.dispatchEvent(new CustomEvent('portfolio:filter', { detail: { category } }));
    });
  });
</script>
