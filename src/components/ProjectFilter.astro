---
import { selectedProjects, categoryLabels } from '../data/projects';

const categories = Object.entries(categoryLabels);
---

<section class="section projects-section" id="selected-projects" aria-labelledby="selected-heading">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">More Work</span>
      <h2 class="section-title" id="selected-heading">
        Selected <span class="title-accent-violet">Projects</span>
      </h2>
      <p class="section-subtitle">Filter by domain to find projects relevant to you.</p>
    </div>

    <!-- Filter tabs -->
    <div class="filter-bar reveal" role="tablist" aria-label="Filter projects by category">
      {categories.map(([key, label]) => (
        <button
          class={`filter-btn ${key === 'all' ? 'active' : ''}`}
          role="tab"
          data-filter={key}
          aria-selected={key === 'all' ? 'true' : 'false'}
          aria-controls="projects-grid"
          id={`tab-${key}`}
        >
          {label}
        </button>
      ))}
    </div>

    <!-- Projects grid -->
    <div
      class="proj-grid"
      id="projects-grid"
      role="tabpanel"
      aria-label="Filtered projects"
    >
      {selectedProjects.map((p, i) => (
        <article
          class={`proj-card glass reveal reveal-d${(i % 3) + 1}`}
          data-category={p.category.join(' ')}
          data-technologies={p.stack.join(' ').toLowerCase()}
          aria-label={p.title}
        >
          {p.isCourseProject && (
            <span class="course-badge" title="IIT Madras Course Project">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M22 10v6M2 10l10-5 10 5-10 5zM6 12v5c3 3 9 3 12 0v-5"/>
              </svg>
              IIT Madras
            </span>
          )}

          <div class="proj-header">
            <div>
              <div class="proj-cats">
                {p.category.map(c => (
                  <span class="proj-cat">{categoryLabels[c] ?? c}</span>
                ))}
              </div>
              <h3 class="proj-title">{p.title}</h3>
            </div>
            <span class="proj-year">{p.year}</span>
          </div>

          <p class="proj-problem">{p.problem}</p>

          <div class="proj-metric">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
              <polyline points="16 7 22 7 22 13"/>
            </svg>
            {p.result}
          </div>

          <div class="tech-tags proj-stack">
            {p.stack.map(t => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>

          <div class="proj-links">
            <a
              href={p.github}
              target="_blank"
              rel="noopener noreferrer"
              class="proj-link"
              aria-label={`View ${p.title} on GitHub`}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.63-5.373-12-12-12z"/>
              </svg>
              GitHub
            </a>
            <a
              href={p.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="proj-link"
              aria-label={`View live demo of ${p.title}`}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
              Demo
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- No results message -->
    <p class="no-results" id="no-results" hidden aria-live="polite">
      No projects found in this category.
    </p>

    <!-- GitHub CTA -->
    <div class="github-cta reveal">
      <a
        href="https://github.com/24f1002299"
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-secondary"
        aria-label="View all repositories on GitHub"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.63-5.373-12-12-12z"/>
        </svg>
        View All 24+ Repositories →
      </a>
    </div>
  </div>
</section>

<style>
  .projects-section { background: var(--bg-surface); }

  /* ── Filter bar ────────────────────────────────────── */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-bottom: var(--s-8);
  }

  .filter-btn {
    padding: 0.45rem 1.1rem;
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    cursor: pointer;
    transition: all var(--t-fast);
    letter-spacing: 0.03em;
  }
  .filter-btn:hover { color: var(--text-primary); border-color: var(--border-strong); }
  .filter-btn.active,
  .filter-btn[aria-selected="true"] {
    background: var(--cyan-dim);
    color: var(--cyan);
    border-color: var(--cyan-border);
  }

  /* ── Grid ─────────────────────────────────────────── */
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
    margin-bottom: var(--s-10);
  }

  /* ── Card ─────────────────────────────────────────── */
  .proj-card {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    position: relative;
    transition: transform var(--t-base), box-shadow var(--t-base), border-color var(--t-base);
  }
  .proj-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-strong);
    box-shadow: 0 12px 32px rgba(0,0,0,0.35);
  }
  .proj-card.hidden { display: none; }

  /* Course badge */
  .course-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.625rem;
    background: var(--cyan-dim);
    color: var(--cyan);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    border: 1px solid var(--cyan-border);
    border-radius: var(--r-full);
    width: fit-content;
  }

  /* Header */
  .proj-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-3);
  }

  .proj-cats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin-bottom: var(--s-1);
  }
  .proj-cat {
    font-size: 0.65rem;
    color: var(--violet);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .proj-title {
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .proj-year {
    font-size: var(--text-xs);
    color: var(--text-faint);
    white-space: nowrap;
    font-weight: 500;
    flex-shrink: 0;
  }

  /* Problem */
  .proj-problem {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.65;
    flex: 1;
  }

  /* Metric */
  .proj-metric {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    padding: var(--s-3);
    background: var(--cyan-dim);
    border: 1px solid var(--cyan-border);
    border-radius: var(--r-md);
    font-size: var(--text-xs);
    color: var(--cyan);
    font-weight: 600;
  }

  /* Stack */
  .proj-stack { margin-top: auto; }

  /* Links */
  .proj-links {
    display: flex;
    gap: var(--s-3);
    padding-top: var(--s-1);
  }
  .proj-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    transition: color var(--t-fast);
    padding: 0.3rem 0;
  }
  .proj-link:hover { color: var(--cyan); }

  /* No results */
  .no-results {
    text-align: center;
    color: var(--text-muted);
    font-size: var(--text-base);
    padding: var(--s-12) 0;
  }

  /* GitHub CTA */
  .github-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--s-6);
  }

  @media (max-width: 1024px) {
    .proj-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .proj-grid { grid-template-columns: 1fr; }
    .proj-card { padding: var(--s-5); }
  }
</style>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards      = document.querySelectorAll<HTMLElement>('.proj-card');
  const noResults  = document.getElementById('no-results');

  const applyFilter = (filter: string) => {
    filterBtns.forEach(b => {
      const active = b.dataset.filter === filter;
      b.classList.toggle('active', active);
      b.setAttribute('aria-selected', String(active));
    });

    let visible = 0;
    cards.forEach(card => {
      const cats = (card.dataset.category ?? '').split(' ');
      const show = filter === 'all' || cats.includes(filter);
      card.classList.toggle('hidden', !show);
      if (show) visible++;
    });
    if (noResults) noResults.hidden = visible > 0;
  };

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';
      applyFilter(filter);
    });
  });

  document.addEventListener('portfolio:filter', ((event: CustomEvent<{ category: string }>) => {
    applyFilter(event.detail.category);
    document.getElementById('selected-projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }) as EventListener);
</script>
