---
import { skillClusters } from '../data/skills';
---

<section class="section skills-section" id="skills" aria-labelledby="skills-heading">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">Expertise</span>
      <h2 class="section-title" id="skills-heading">
        Skills &amp; <span class="title-accent">Technologies</span>
      </h2>
      <p class="section-subtitle">
        Organised by domain — with evidence from real projects, not percentages.
      </p>
    </div>

    <div class="skills-grid">
      {skillClusters.map((cluster, i) => (
        <article
          class={`skill-cluster glass reveal reveal-d${(i % 3) + 1}`}
          data-accent={cluster.accent}
          aria-labelledby={`cluster-${i}`}
        >
          <h3 class={`cluster-name text-${cluster.accent}`} id={`cluster-${i}`}>
            {cluster.name}
          </h3>
          <ul class="skill-list" role="list" aria-label={`${cluster.name} skills`}>
            {cluster.skills.map(s => (
              <li class="skill-item" role="listitem">
                <span class="skill-name">{s.name}</span>
                {s.evidence && (
                  <span class={`skill-evidence evidence-${cluster.accent}`}>{s.evidence}</span>
                )}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills-section { background: var(--bg-base); }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-6);
  }

  .skill-cluster {
    padding: var(--s-6);
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    transition: transform var(--t-base), border-color var(--t-base);
    position: relative;
    overflow: hidden;
  }
  .skill-cluster::after {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    opacity: 0;
    transition: opacity var(--t-base);
    border-radius: var(--r-lg) var(--r-lg) 0 0;
  }
  .skill-cluster[data-accent="cyan"]::after   { background: linear-gradient(90deg, transparent, var(--cyan), transparent); }
  .skill-cluster[data-accent="violet"]::after { background: linear-gradient(90deg, transparent, var(--violet), transparent); }
  .skill-cluster[data-accent="neutral"]::after { background: linear-gradient(90deg, transparent, var(--border-strong), transparent); }
  .skill-cluster:hover::after { opacity: 1; }
  .skill-cluster:hover { transform: translateY(-3px); border-color: var(--border-strong); }

  .cluster-name {
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
  }
  .text-cyan    { color: var(--cyan); }
  .text-violet  { color: var(--violet); }
  .text-neutral { color: var(--text-muted); }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .skill-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    padding: var(--s-2) var(--s-3);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    transition: border-color var(--t-fast);
  }
  .skill-item:hover { border-color: var(--border-strong); }

  .skill-name {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
  }

  .skill-evidence {
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: var(--r-sm);
    padding: 0.1rem 0.45rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .evidence-cyan   { background: var(--cyan-dim);   color: var(--cyan);   border: 1px solid var(--cyan-border); }
  .evidence-violet { background: var(--violet-dim); color: var(--violet); border: 1px solid var(--violet-border); }
  .evidence-neutral { background: var(--bg-overlay); color: var(--text-muted); }

  @media (max-width: 1024px) {
    .skills-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .skills-grid { grid-template-columns: 1fr; }
    .skill-cluster { padding: var(--s-5); }
  }
</style>
