---
// Hero.astro — Split-layout hero with animated AI system diagram
const base = `${import.meta.env.BASE_URL}/`;
---

<section class="hero" id="hero" aria-label="Introduction">
  <!-- Grid background -->
  <div class="hero-grid" aria-hidden="true"></div>
  <!-- Glow blobs -->
  <div class="glow-cyan"   aria-hidden="true"></div>
  <div class="glow-violet" aria-hidden="true"></div>

  <div class="hero-inner container">
    <!-- ── Left: Text ──────────────────────────────── -->
    <div class="hero-text">
      <p class="hero-eyebrow reveal">
        <span class="dot"></span> Available for AI/ML &amp; Software Engineering roles
      </p>

      <h1 class="hero-name reveal reveal-d1">
        Hasrat<br />Hussain
      </h1>

      <p class="hero-role reveal reveal-d2">
        AI/ML Engineer &amp;<br class="role-break" /> Full-Stack Developer
      </p>

      <p class="hero-tagline reveal reveal-d3">
        Builds intelligent agents, LLM systems, computer vision
        models, and production-ready applications.
      </p>

      <div class="hero-chips reveal reveal-d4" role="list" aria-label="Core specialisations">
        <span role="listitem">GenAI</span>
        <span role="listitem">LLMs</span>
        <span role="listitem">Computer Vision</span>
        <span role="listitem">AI Agents</span>
        <span role="listitem">Backend Systems</span>
      </div>

      <div class="hero-cta reveal reveal-d4">
        <a href="#work" class="btn btn-primary">
          View Projects
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={`${base}assets/resume.pdf`} class="btn btn-secondary" download aria-label="Download resume PDF">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/>
          </svg>
          Resume
        </a>
      </div>
    </div>

    <!-- ── Right: AI System Diagram ───────────────── -->
    <div class="hero-diagram reveal reveal-d2" aria-label="Animated AI system architecture diagram" role="img">
      <svg
        class="ai-svg"
        viewBox="0 0 420 380"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
      >
        <defs>
          <!-- Glow filter -->
          <filter id="node-glow" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="3" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <filter id="node-glow-violet" x="-40%" y="-40%" width="180%" height="180%">
            <feGaussianBlur stdDeviation="3" result="blur"/>
            <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
          <!-- Background radial -->
          <radialGradient id="bg-glow" cx="50%" cy="45%" r="52%">
            <stop offset="0%"   stop-color="#00D4AA" stop-opacity="0.10"/>
            <stop offset="100%" stop-color="#00D4AA" stop-opacity="0"/>
          </radialGradient>
          <!-- Violet gradient node fill -->
          <linearGradient id="node-fill-cyan" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%"   stop-color="#00D4AA" stop-opacity="0.12"/>
            <stop offset="100%" stop-color="#00D4AA" stop-opacity="0.04"/>
          </linearGradient>
          <linearGradient id="node-fill-violet" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%"   stop-color="#7C5CFC" stop-opacity="0.14"/>
            <stop offset="100%" stop-color="#7C5CFC" stop-opacity="0.04"/>
          </linearGradient>
        </defs>

        <!-- Background glow blob -->
        <ellipse cx="210" cy="175" rx="190" ry="150" fill="url(#bg-glow)"/>

        <!-- ── Connections (animated dashes) ──────── -->
        <!-- LLM → Agent -->
        <line class="conn" x1="210" y1="92" x2="210" y2="145" stroke="#00D4AA" stroke-width="1.5" stroke-dasharray="5 4"/>
        <!-- Agent → RAG -->
        <line class="conn" x1="175" y1="175" x2="95"  y2="232" stroke="#00D4AA" stroke-width="1.5" stroke-dasharray="5 4"/>
        <!-- Agent → Tools -->
        <line class="conn" x1="210" y1="180" x2="210" y2="232" stroke="#00D4AA" stroke-width="1.5" stroke-dasharray="5 4"/>
        <!-- Agent → Memory -->
        <line class="conn conn-violet" x1="245" y1="175" x2="325" y2="232" stroke="#7C5CFC" stroke-width="1.5" stroke-dasharray="5 4"/>
        <!-- RAG → App -->
        <line class="conn" x1="110" y1="272" x2="178" y2="318" stroke="#00D4AA" stroke-width="1.5" stroke-dasharray="5 4" stroke-opacity="0.6"/>
        <!-- Tools → App -->
        <line class="conn" x1="210" y1="272" x2="210" y2="318" stroke="#00D4AA" stroke-width="1.5" stroke-dasharray="5 4" stroke-opacity="0.6"/>
        <!-- Memory → App -->
        <line class="conn conn-violet" x1="310" y1="272" x2="242" y2="318" stroke="#7C5CFC" stroke-width="1.5" stroke-dasharray="5 4" stroke-opacity="0.6"/>

        <!-- ── Nodes ───────────────────────────────── -->

        <!-- LLM Core (top) -->
        <rect class="node node-main" x="140" y="48" width="140" height="48" rx="10"
              fill="url(#node-fill-cyan)" stroke="#00D4AA" stroke-width="1.5"
              filter="url(#node-glow)"/>
        <text x="210" y="69" text-anchor="middle"
              font-family="Space Grotesk" font-size="11" font-weight="700"
              letter-spacing="0.08em" fill="#00D4AA">LLM CORE</text>
        <text x="210" y="85" text-anchor="middle"
              font-family="Inter" font-size="9" fill="#8B949E">GPT · Gemini · Llama</text>

        <!-- Agent Layer (middle) -->
        <rect class="node node-main" x="140" y="145" width="140" height="48" rx="10"
              fill="url(#node-fill-cyan)" stroke="#00D4AA" stroke-width="1.5"
              filter="url(#node-glow)"/>
        <text x="210" y="165" text-anchor="middle"
              font-family="Space Grotesk" font-size="11" font-weight="700"
              letter-spacing="0.08em" fill="#00D4AA">AGENT LAYER</text>
        <text x="210" y="182" text-anchor="middle"
              font-family="Inter" font-size="9" fill="#8B949E">AutoGen · CrewAI · LangGraph</text>

        <!-- RAG -->
        <rect class="node node-sub" x="44" y="232" width="110" height="44" rx="8"
              fill="url(#node-fill-cyan)" stroke="#00D4AA" stroke-width="1.2"/>
        <text x="99" y="251" text-anchor="middle"
              font-family="Space Grotesk" font-size="10" font-weight="600" fill="#F5F7FA">RAG</text>
        <text x="99" y="266" text-anchor="middle"
              font-family="Inter" font-size="8.5" fill="#8B949E">ChromaDB · Embeddings</text>

        <!-- Tools -->
        <rect class="node node-sub" x="154" y="232" width="110" height="44" rx="8"
              fill="url(#node-fill-cyan)" stroke="#00D4AA" stroke-width="1.2"/>
        <text x="209" y="251" text-anchor="middle"
              font-family="Space Grotesk" font-size="10" font-weight="600" fill="#F5F7FA">TOOLS</text>
        <text x="209" y="266" text-anchor="middle"
              font-family="Inter" font-size="8.5" fill="#8B949E">APIs · Functions</text>

        <!-- Memory -->
        <rect class="node node-sub-violet" x="264" y="232" width="110" height="44" rx="8"
              fill="url(#node-fill-violet)" stroke="#7C5CFC" stroke-width="1.2"
              filter="url(#node-glow-violet)"/>
        <text x="319" y="251" text-anchor="middle"
              font-family="Space Grotesk" font-size="10" font-weight="600" fill="#F5F7FA">MEMORY</text>
        <text x="319" y="266" text-anchor="middle"
              font-family="Inter" font-size="8.5" fill="#8B949E">Context · State</text>

        <!-- Production App (bottom) -->
        <rect class="node node-output" x="140" y="318" width="140" height="44" rx="10"
              fill="url(#node-fill-cyan)" stroke="rgba(0,212,170,0.45)" stroke-width="1.5"/>
        <text x="210" y="337" text-anchor="middle"
              font-family="Space Grotesk" font-size="11" font-weight="700"
              letter-spacing="0.06em" fill="#00D4AA">PRODUCTION</text>
        <text x="210" y="352" text-anchor="middle"
              font-family="Inter" font-size="9" fill="#8B949E">FastAPI · Django · Streamlit</text>

        <!-- Floating dots for visual interest -->
        <circle class="dot-float" cx="60"  cy="90"  r="3" fill="#00D4AA" opacity="0.4"/>
        <circle class="dot-float" cx="370" cy="120" r="2" fill="#7C5CFC" opacity="0.4"/>
        <circle class="dot-float" cx="40"  cy="200" r="2" fill="#00D4AA" opacity="0.3"/>
        <circle class="dot-float" cx="385" cy="280" r="3" fill="#7C5CFC" opacity="0.35"/>
      </svg>
    </div>
  </div>

  <!-- Scroll cue -->
  <a href="#credibility" class="scroll-cue" aria-label="Scroll down">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </a>
</section>

<style>
  /* ── Hero shell ───────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    overflow: hidden;
    padding-top: 72px;
  }

  /* ── Background grid ──────────────────────────────── */
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, rgba(255,255,255,0.055) 1px, transparent 1px);
    background-size: 36px 36px;
    pointer-events: none;
  }

  /* ── Glow blobs ───────────────────────────────────── */
  .glow-cyan, .glow-violet {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }
  .glow-cyan {
    width: 600px; height: 600px;
    top: -100px; right: -80px;
    background: rgba(0, 212, 170, 0.06);
  }
  .glow-violet {
    width: 400px; height: 400px;
    bottom: 50px; left: -120px;
    background: rgba(124, 92, 252, 0.05);
  }

  /* ── Inner layout ─────────────────────────────────── */
  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--s-12);
    padding-block: var(--s-16);
  }

  /* ── Text column ──────────────────────────────────── */
  .hero-text { display: flex; flex-direction: column; gap: var(--s-6); }

  /* Availability badge */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    width: fit-content;
  }
  .dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34,197,94,0.2);
    animation: pulse-dot 2.4s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse-dot {
    0%, 100% { box-shadow: 0 0 0 3px rgba(34,197,94,0.2); }
    50%       { box-shadow: 0 0 0 6px rgba(34,197,94,0); }
  }

  /* Name */
  .hero-name {
    font-size: var(--text-4xl);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.95;
    color: var(--text-primary);
  }

  /* Role */
  .hero-role {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--text-muted);
    line-height: 1.35;
  }
  .hero-role br.role-break { display: none; }

  /* Tagline */
  .hero-tagline {
    font-size: var(--text-base);
    color: var(--text-muted);
    line-height: 1.75;
    max-width: 440px;
  }

  /* Chips */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .hero-chips span {
    padding: 0.3rem 0.75rem;
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-size: var(--text-xs);
    font-weight: 500;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    transition: border-color var(--t-fast), color var(--t-fast);
  }
  .hero-chips span:hover { border-color: var(--cyan-border); color: var(--cyan); }

  /* CTAs */
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding-top: var(--s-2);
  }

  /* ── Diagram column ───────────────────────────────── */
  .hero-diagram { display: flex; align-items: center; justify-content: center; }
  .ai-svg { width: 100%; max-width: 420px; }

  /* Node animation */
  .node-main {
    animation: node-blink 3s ease-in-out infinite;
  }
  .node-sub {
    animation: node-blink 3s ease-in-out infinite 0.5s;
  }
  .node-sub-violet {
    animation: node-blink 3s ease-in-out infinite 1s;
  }
  .node-output {
    animation: node-blink 3s ease-in-out infinite 1.5s;
  }

  /* Dashed line flow animation */
  .conn {
    stroke-dashoffset: 0;
    animation: data-flow 1.8s linear infinite;
  }
  .conn-violet {
    animation: data-flow 1.8s linear infinite 0.4s;
  }

  /* Floating decorative dots */
  .dot-float:nth-child(1) { animation: float 4s ease-in-out infinite; }
  .dot-float:nth-child(2) { animation: float 5s ease-in-out infinite 1s; }
  .dot-float:nth-child(3) { animation: float 3.5s ease-in-out infinite 0.5s; }
  .dot-float:nth-child(4) { animation: float 4.5s ease-in-out infinite 1.5s; }

  /* ── Scroll cue ────────────────────────────────────── */
  .scroll-cue {
    position: absolute;
    bottom: var(--s-8);
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-faint);
    animation: float 2.5s ease-in-out infinite;
    transition: color var(--t-fast);
  }
  .scroll-cue:hover { color: var(--text-muted); }

  /* ── Responsive ────────────────────────────────────── */
  @media (max-width: 1024px) {
    .hero-inner { gap: var(--s-8); }
  }

  @media (max-width: 768px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
      padding-block: var(--s-12);
    }
    .hero-eyebrow  { align-self: center; }
    .hero-tagline  { max-width: 100%; }
    .hero-cta      { justify-content: center; }
    .hero-chips    { justify-content: center; }
    .hero-diagram  { order: -1; }
    .ai-svg        { max-width: 300px; }
    .role-break    { display: block; }
    .hero-name     { font-size: clamp(2.4rem, 8vw, 4rem); }
  }

  @media (max-width: 480px) {
    .hero-diagram { display: none; }
    .glow-cyan, .glow-violet { display: none; }
  }
</style>
