---
// CredibilityStrip.astro
---

<div class="credibility" id="credibility" aria-label="Credibility highlights">
  <div class="container">
    <div class="strip-inner">
      <!-- Org + domain tags -->
      <div class="org-tags" role="list" aria-label="Affiliations and domains">
        {['IIT Madras', 'AI / ML', 'GenAI', 'Computer Vision', 'Backend Systems', 'RL / GRPO'].map(t => (
          <span class="org-tag" role="listitem">{t}</span>
        ))}
      </div>

      <!-- Divider -->
      <div class="strip-divider" aria-hidden="true"></div>

      <!-- Stats -->
      <div class="stats" role="list" aria-label="Key statistics">
        <div class="stat" role="listitem">
          <span class="stat-num">12<span class="stat-plus">+</span></span>
          <span class="stat-lbl">Projects</span>
        </div>
        <div class="stat" role="listitem">
          <span class="stat-num">6</span>
          <span class="stat-lbl">Certifications</span>
        </div>
        <div class="stat" role="listitem">
          <span class="stat-num">3</span>
          <span class="stat-lbl">Experiences</span>
        </div>
        <div class="stat" role="listitem">
          <span class="stat-num" style="font-size: var(--text-base); letter-spacing: -0.01em;">IIT Madras</span>
          <span class="stat-lbl">Data Science</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .credibility {
    border-top:    1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--bg-surface);
    padding-block: var(--s-6);
  }

  .strip-inner {
    display: flex;
    align-items: center;
    gap: var(--s-8);
    flex-wrap: wrap;
  }

  /* ── Org tags ────────── */
  .org-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    flex: 1;
  }
  .org-tag {
    padding: 0.3rem 0.875rem;
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    white-space: nowrap;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .org-tag:hover { color: var(--cyan); border-color: var(--cyan-border); }

  /* ── Divider ─────────── */
  .strip-divider {
    width: 1px;
    height: 36px;
    background: var(--border-strong);
    flex-shrink: 0;
  }

  /* ── Stats ───────────── */
  .stats {
    display: flex;
    gap: var(--s-8);
    flex-wrap: wrap;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: center;
    min-width: 60px;
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--cyan);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .stat-plus { font-size: 0.8em; }

  .stat-lbl {
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .strip-inner { gap: var(--s-6); }
    .strip-divider { display: none; }
    .stats { gap: var(--s-6); }
  }

  @media (max-width: 480px) {
    .org-tags { display: none; }
  }
</style>
