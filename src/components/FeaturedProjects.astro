---
import { featuredProjects } from '../data/projects';

// Visual config per featured project
const visuals = [
  {
    // ModelCardAudit — AI Agents / RL
    pattern: 'pattern-agents',
    badge: 'AI AGENTS · RESPONSIBLE AI',
    badgeColor: 'cyan',
    metricLabel: 'RL Benchmark',
  },
  {
    // Multi-Agent Data Analyst
    pattern: 'pattern-multiagent',
    badge: 'AI AGENTS · MULTI-AGENT',
    badgeColor: 'cyan',
    metricLabel: 'Architecture',
  },
  {
    // Plant SR cGAN
    pattern: 'pattern-cv',
    badge: 'COMPUTER VISION · GAN',
    badgeColor: 'violet',
    metricLabel: 'vs Bicubic Baseline',
  },
];
---

<section class="section" id="work" aria-labelledby="featured-heading">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">Featured Work</span>
      <h2 class="section-title" id="featured-heading">
        Selected <span class="title-accent">Projects</span>
      </h2>
      <p class="section-subtitle">
        My strongest work — each a full engineering challenge from problem to production.
      </p>
    </div>

    <div class="featured-list">
      {featuredProjects.map((project, i) => {
        const v = visuals[i];
        return (
          <article class={`featured-card glass reveal reveal-d${i + 1}`}>
            <!-- Visual area -->
            <div class={`feat-visual ${v.pattern}`} aria-hidden="true">
              <span class={`feat-badge badge-${v.badgeColor}`}>{v.badge}</span>
              <div class="feat-year">{project.year}</div>
            </div>

            <!-- Content -->
            <div class="feat-body">
              <div class="feat-meta">
                <h3 class="feat-title">{project.title}</h3>
                <div class="feat-metric">
                  <span class="metric-value">{project.result.split('—')[0].trim()}</span>
                  <span class="metric-label">{v.metricLabel}</span>
                </div>
              </div>

              <p class="feat-problem">{project.problem}</p>

              <div class="tech-tags feat-stack">
                {project.stack.map(t => (
                  <span class="tech-tag">{t}</span>
                ))}
              </div>

              <div class="feat-links">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-outline-cyan"
                  aria-label={`View ${project.title} on GitHub`}
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.63-5.373-12-12-12z"/>
                  </svg>
                  GitHub
                </a>
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-outline-cyan"
                  aria-label={`View live demo of ${project.title}`}
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/>
                  </svg>
                  Live Demo
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* ── List layout ──────────────────────────────────── */
  .featured-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-8);
  }

  /* ── Card ─────────────────────────────────────────── */
  .featured-card {
    display: grid;
    grid-template-columns: 420px 1fr;
    min-height: 300px;
    overflow: hidden;
    transition: transform var(--t-base), box-shadow var(--t-base);
  }
  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px rgba(0,0,0,0.4);
  }
  /* Alternate cards: swap visual to right */
  .featured-card:nth-child(even) {
    grid-template-columns: 1fr 420px;
  }
  .featured-card:nth-child(even) .feat-visual {
    order: 2;
  }
  .featured-card:nth-child(even) .feat-body {
    order: 1;
  }

  /* ── Visual area ──────────────────────────────────── */
  .feat-visual {
    position: relative;
    overflow: hidden;
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: var(--s-6);
  }

  /* Pattern: AI Agents — node network */
  .pattern-agents {
    background:
      radial-gradient(circle at 20% 30%, rgba(0,212,170,0.14) 0%, transparent 50%),
      radial-gradient(circle at 70% 70%, rgba(0,212,170,0.08) 0%, transparent 50%),
      var(--bg-elevated);
  }
  .pattern-agents::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle, rgba(0,212,170,0.3) 1.5px, transparent 1.5px);
    background-size: 28px 28px;
  }

  /* Pattern: Multi-Agent — grid + lines */
  .pattern-multiagent {
    background:
      radial-gradient(circle at 60% 40%, rgba(0,212,170,0.12) 0%, transparent 55%),
      var(--bg-elevated);
  }
  .pattern-multiagent::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,212,170,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,212,170,0.07) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  /* Pattern: Computer Vision — scan lines */
  .pattern-cv {
    background:
      radial-gradient(circle at 40% 50%, rgba(124,92,252,0.15) 0%, transparent 55%),
      var(--bg-elevated);
  }
  .pattern-cv::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(124,92,252,0.08) 1px, transparent 1px);
    background-size: 100% 16px;
  }

  /* Badge */
  .feat-badge {
    position: absolute;
    top: var(--s-6);
    left: var(--s-6);
    padding: 0.25rem 0.75rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: var(--r-full);
  }
  .badge-cyan   { background: var(--cyan-dim);   color: var(--cyan);   border: 1px solid var(--cyan-border); }
  .badge-violet { background: var(--violet-dim); color: var(--violet); border: 1px solid var(--violet-border); }

  .feat-year {
    position: absolute;
    top: var(--s-6);
    right: var(--s-6);
    font-size: var(--text-xs);
    color: var(--text-faint);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  /* ── Body ─────────────────────────────────────────── */
  .feat-body {
    padding: var(--s-8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-6);
  }

  .feat-meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .feat-title {
    font-size: var(--text-xl);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    flex: 1;
  }

  .feat-metric {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .feat-problem {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .feat-stack { margin-top: auto; }

  .feat-links {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  /* ── Responsive ───────────────────────────────────── */
  @media (max-width: 1024px) {
    .featured-card,
    .featured-card:nth-child(even) {
      grid-template-columns: 1fr;
    }
    .featured-card:nth-child(even) .feat-visual,
    .featured-card:nth-child(even) .feat-body {
      order: unset;
    }
    .feat-visual { min-height: 200px; }
    .feat-body { padding: var(--s-6); }
  }

  @media (max-width: 640px) {
    .feat-meta { flex-direction: column; }
    .feat-metric { align-items: flex-start; }
    .feat-body { padding: var(--s-5); }
  }
</style>
