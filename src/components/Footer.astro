---
// Footer.astro
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-inner">
      <!-- Top: CTA headline -->
      <div class="footer-headline reveal">
        <p class="footer-tagline">Let's build something intelligent.</p>
        <h2 class="footer-name">
          <span class="footer-bracket">&lt;</span>Hasrat Hussain<span class="footer-bracket">/&gt;</span>
        </h2>
        <p class="footer-role">AI/ML Engineer · Full-Stack Developer</p>
      </div>

      <!-- Social + CTA button -->
      <div class="footer-actions reveal reveal-d2">
        <div class="footer-socials" role="list" aria-label="Social media links">
          <a
            href="https://github.com/24f1002299"
            target="_blank" rel="noopener noreferrer"
            class="footer-social"
            role="listitem"
            aria-label="GitHub"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.63-5.373-12-12-12z"/>
            </svg>
          </a>
          <a
            href="https://www.linkedin.com/in/hasrat-hussain-08b637233/"
            target="_blank" rel="noopener noreferrer"
            class="footer-social"
            role="listitem"
            aria-label="LinkedIn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a
            href="https://x.com/hasratmd697"
            target="_blank" rel="noopener noreferrer"
            class="footer-social"
            role="listitem"
            aria-label="X / Twitter"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <a
            href="mailto:hasratmd697@gmail.com"
            class="footer-social"
            role="listitem"
            aria-label="Email"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </a>
        </div>
        <a href="mailto:hasratmd697@gmail.com" class="btn btn-primary footer-cta">
          Let's work together →
        </a>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="footer-bottom" aria-label="Copyright information">
      <p class="footer-copy">
        &copy; {year} Hasrat Hussain. Built with Astro.
      </p>
      <nav aria-label="Footer navigation">
        <a href="#hero"    class="footer-nav-link">Top</a>
        <a href="#work"    class="footer-nav-link">Work</a>
        <a href="#contact" class="footer-nav-link">Contact</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border);
    padding-block: var(--s-16) var(--s-8);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--s-10);
    padding-bottom: var(--s-10);
    border-bottom: 1px solid var(--border);
  }

  /* Headline */
  .footer-tagline {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-bottom: var(--s-3);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: var(--s-2);
  }

  .footer-bracket { color: var(--cyan); }

  .footer-role {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Actions */
  .footer-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--s-6);
  }

  .footer-socials {
    display: flex;
    gap: var(--s-3);
  }

  .footer-social {
    width: 42px; height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    transition: all var(--t-fast);
  }
  .footer-social:hover {
    background: var(--cyan-dim);
    color: var(--cyan);
    border-color: var(--cyan-border);
    transform: translateY(-3px);
  }

  .footer-cta { align-self: flex-end; }

  /* Bottom bar */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding-top: var(--s-6);
  }

  .footer-copy {
    font-size: var(--text-xs);
    color: var(--text-faint);
  }

  .footer-nav-link {
    display: inline-block;
    margin-left: var(--s-4);
    font-size: var(--text-xs);
    color: var(--text-faint);
    transition: color var(--t-fast);
  }
  .footer-nav-link:hover { color: var(--cyan); }

  @media (max-width: 768px) {
    .footer-inner { flex-direction: column; align-items: flex-start; }
    .footer-actions { align-items: flex-start; }
    .footer-cta { align-self: flex-start; }
    .footer-name { font-size: var(--text-2xl); }
  }
</style>
