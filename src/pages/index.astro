---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import CredibilityStrip from '../components/CredibilityStrip.astro';
import WhatIBuild from '../components/WhatIBuild.astro';
import AISystemMap from '../components/AISystemMap.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import Journey from '../components/Journey.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import Exploring from '../components/Exploring.astro';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav />
  <main id="main-content">
    <Hero />
    <CredibilityStrip />
    <WhatIBuild />
    <AISystemMap />
    <FeaturedProjects />
    <ProjectFilter />
    <Journey />
    <Experience />
    <Skills />
    <Certifications />
    <Exploring />
    <About />
    <Contact />
  </main>
  <Footer />
</Layout>
