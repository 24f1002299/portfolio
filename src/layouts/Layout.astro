---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Hasrat Hussain | AI/ML Engineer & Full-Stack Developer',
  description = 'AI/ML engineer building intelligent agents, LLM applications, computer vision systems and production-ready backend software. Data Science @ IIT Madras.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/portfolio/og-preview.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070A0F" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Hasrat Hussain" />
    <meta name="keywords" content="AI engineer, ML engineer, LLM, RAG, multi-agent, computer vision, FastAPI, Django, IIT Madras, data science" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Hasrat Hussain" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@hasratmd697" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Hasrat Hussain",
        "jobTitle": "AI/ML Engineer & Full-Stack Developer",
        "url": "https://24f1002299.github.io/portfolio/",
        "sameAs": [
          "https://github.com/24f1002299",
          "https://www.linkedin.com/in/hasrat-hussain-08b637233/",
          "https://x.com/hasratmd697"
        ],
        "knowsAbout": ["Machine Learning", "Large Language Models", "Computer Vision", "AI Agents", "FastAPI", "Django"]
      })}
    </script>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/favicon.svg`} />

    <!-- Fonts: preconnect then load -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>
